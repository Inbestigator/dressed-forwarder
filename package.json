{
  "name": "dressed-forwarder",
  "version": "0.2.0",
  "description": "Simple event proxy to forward events from a gateway connection to webhook server.",
  "scripts": {
    "dist": "rm -rf dist && bun tsc",
    "checks": "bun dist && bun --bun biome check --write",
    "dry-publish": "bun publish --dry-run"
  },
  "dependencies": {
    "@dressed/ws": "^0.5.0-canary.1",
    "dressed": "^2.0.0-canary.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.3"
  },
  "exports": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "homepage": "https://dressed.js.org",
  "keywords": [
    "bot",
    "proxy",
    "forwarder",
    "serverless",
    "discord",
    "discord-bot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inbestigator/dressed-forwarder.git"
  }
}
